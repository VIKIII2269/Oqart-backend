# Server Configuration
PORT=8080
ENV=development
APP_NAME=OQart Backend
APP_VERSION=1.0.0

# Database Configuration
DATABASE_URL=postgresql://oqart:oqart@localhost:5432/oqart?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=oqart
DB_PASSWORD=oqart
DB_NAME=oqart
DB_SSLMODE=disable
DB_MAX_CONNECTIONS=25
DB_MAX_IDLE=5
DB_MAX_LIFETIME=5m

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-key-min-32-chars-change-in-production
JWT_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=720h
JWT_ALGORITHM=HS256

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# AWS S3 Configuration (Optional - for production)
USE_S3=false
S3_BUCKET=oqart-uploads
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_USE_PATH_STYLE=false

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@oqart.com
EMAIL_FROM_NAME=OQart

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Payment Gateway - Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

# Payment Gateway - Stripe (Backup)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# GST Verification API
GST_API_KEY=
GST_API_URL=https://api.gstincheck.co.in/check/
GST_API_ENABLED=false

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-CSRF-Token

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_DURATION=1h
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_DURATION=1m

# Security
BCRYPT_COST=12
OTP_LENGTH=6
OTP_EXPIRY=5m
PASSWORD_RESET_EXPIRY=30m
EMAIL_VERIFY_EXPIRY=24h

# Business Rules
MAX_CART_ITEMS=20
MAX_QUANTITY_PER_ITEM=10
CART_EXPIRY_DAYS=7
ORDER_AUTO_CANCEL_MINUTES=30
VENDOR_APPROVAL_DAYS=3
RETURN_WINDOW_DAYS=15
COD_MAX_AMOUNT=5000
COD_FEE=50

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_OUTPUT=stdout

# Feature Flags
FEATURE_GOOGLE_AUTH=true
FEATURE_COD=true
FEATURE_WALLET=false
FEATURE_BULK_UPLOAD=true
FEATURE_GST_VERIFICATION=false

# Admin Configuration
ADMIN_EMAIL=admin@oqart.com
ADMIN_PASSWORD=Admin@123456
